(label "+3V3_BK" (at 394.97 185.42 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "52fce8f6-95d6-4a9d-812a-b0f89806c203"))
(text "POWER. J0 battery in -> 10A ATO -> SMDJ58CA -> LM74800 + 2x BSC070N10NS5 back-to-back (VBAT_P).\nOV 30.3V / UV 5.5V (191k/45.3k/10k, 1.231V thresholds). LM5176 buck-boost -> +12V (FB 140k/10k, RT 27.4k ~300kHz, 8mR sense).\nTPS56637 -> +5V (FB 75k/10k = 5.1V, 3.3uH). TPS56637 -> +3V3 from +12V (FB 45.3k/10k, 2.2uH, 3x22u), >=3A. MODE open = FCCM.\nSAFE DOMAIN: LMR36506 buck VBAT_P -> +3V3_BK (always on); TPS2116 priority mux VIN1=+3V3 / VIN2=+3V3_BK -> +3V3_SAFE (MCU, FRAM, WDT, I/O, E-stop logic)." (exclude_from_sim no) (at 15 12 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "c27455d4-5c45-4177-a75b-b93a1778d60d"))
)
