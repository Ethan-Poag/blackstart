(version 1)
# Blackstart v4 custom rules. 600 V spacing per Ethan 2026-10-25 -- NEEDS PROFESSIONAL (safety/compliance) REVIEW.
# Full-voltage line/neutral copper (netclass HV_LINE) on OUTER layers: 3.0 mm to any other net.
(rule "HV line outer 3mm"
  (layer outer)
  (condition "A.hasNetclass('HV_LINE') && !B.hasNetclass('HV_LINE_DIV')")
  (constraint clearance (min 3.0mm)))
# Inside a series divider string each resistor sees only a fraction of the line voltage: 1.5 mm between divider parts.
(rule "HV divider string 1.5mm"
  (layer outer)
  (condition "A.hasNetclass('HV_LINE') && B.hasNetclass('HV_LINE_DIV')")
  (constraint clearance (min 1.5mm)))
(rule "HV divider nodes 1.5mm"
  (condition "A.hasNetclass('HV_LINE_DIV') && B.Type != 'Zone'")
  (constraint clearance (min 1.5mm)))
# Inner layers: HV_LINE netclass clearance (1.5 mm) applies.

# Board-setup minimums were lowered to 0.3/0.15 mm (0.075 annular) ONLY so the
# SN65DSI83 0.5 mm-pitch BGA (U21) can use filled+capped via-in-pad.  Everywhere
# else the old 0.4/0.2 mm (0.1 annular) via minimum is still enforced here.
(rule "via min outside U21 BGA"
  (condition "A.Type == 'Via' && !A.intersectsCourtyard('U21')")
  (constraint via_diameter (min 0.4mm))
  (constraint hole_size (min 0.2mm))
  (constraint annular_width (min 0.1mm)))

# --- M7 (2026-10-25): binding sheet /workspace/compliance/hv_layout_rules_600V.md (also cited in LAYOUT_RULES.md).
# Severity "warning" so they are reported separately from the legacy error set; the authoritative check is
# hvrules.py (node-voltage aware, slot creepage). These are NOT relaxations: none of the error rules above changed.
(rule "HV sheet: line-line outer 6.6mm (phase-phase incl GEN vs BUS)"
  (severity warning)
  (layer outer)
  (condition "A.hasNetclass('HV_LINE') && B.hasNetclass('HV_LINE') && A.NetName != B.NetName && !A.NetName.contains('_N') && !B.NetName.contains('_N')")
  (constraint clearance (min 6.6mm)))
(rule "HV sheet: line-N outer 5.5mm"
  (severity warning)
  (layer outer)
  (condition "A.hasNetclass('HV_LINE') && B.hasNetclass('HV_LINE') && A.NetName != B.NetName")
  (constraint clearance (min 5.5mm)))
(rule "HV sheet: hot copper to board edge 8.0mm"
  (severity warning)
  (condition "A.hasNetclass('HV_LINE') || A.hasNetclass('HV_LINE_DIV')")
  (constraint edge_clearance (min 8.0mm)))
