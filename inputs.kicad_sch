(global_label "DI_BIAS_FLT_N" (shape bidirectional) (at 1115.06 283.21 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left)) (uuid "e7c266b7-36ae-408b-b0fa-c0de9b6a4704") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 1115.06 283.21 0) (effects (font (size 1.27 1.27)) hide)))
(text "DI_BIAS eFuses (Batch 18): Q36/Q39 drain -> U89/U90 TPS26621 (ILIM 33.2k = 0.20 A, auto-retry) -> F101/F102 1210L020/72 PTC backup -> DI_BIAS_A/B.\nBatch 21 (Safety S7-N13): RTN pin 5, PowerPAD (EP) and OVP pin 3 tied to GND (OVP disabled; reverse polarity is blocked upstream by U1 LM74800); dVdT/ILIM to GND; EP to GND plane with thermal vias. U89/U90 MUST stay on VBAT_P behind U1 LM74800, never on BAT_IN (62 V abs max vs ~64.5 V TVS clamp). FLT open-drain wired-OR = DI_BIAS_FLT_N -> U76 P17, one 10k R635 to +3V3_SAFE.\nFLT low = current limit / thermal shutdown / UVLO / start-up ramp; released (high) = normal on OR eFuse unpowered (bank switched off by Q36/Q39). Open wire to P17 also reads high." (exclude_from_sim no) (at 1021.08 256.54 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "ce4802f4-e756-48bf-a854-efb4ebd74f30"))
(text "Batch 27: R638 100R isolates C129 (1u) from U25A output (TLV906x cap-load drive\n100 pF, SBOS839N p1); DC loads stay on VMID = feedback node, no offset." (exclude_from_sim no) (at 373.38 604.52 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ead0b6cb-9c50-41b4-839f-00780e862ad3"))
