(text "J31 -> harness (2x Molex 43025-1600 + 32x 43030-0001, ~80 mm, pin n to pin n) -> J32 on HV metering daughter (genctl_meter)." (exclude_from_sim no) (at 25.40 40.64 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7c543600-2282-43e1-b36a-35b127309b5c"))
(text "All 16 pins are SELV. Pin 15 MTR_DET_N: daughter straps it to GND; R636 pulls high; read on U73 P14 (TCA9555 @0x20). Pin 16 spare (NC)." (exclude_from_sim no) (at 25.40 45.72 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3696c327-d009-43f2-a56e-13a1b63397e7"))
